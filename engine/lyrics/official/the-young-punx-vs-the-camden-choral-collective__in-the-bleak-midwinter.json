    },
    {
      "line_index": 8,
      "original": "Poor as I am?",
      "simlish": "Purasa nam"
    },
    {
      "line_index": 9,
      "original": "If I were a shepherd",
      "simlish": "Yifawa shi bepper"
    },
    {

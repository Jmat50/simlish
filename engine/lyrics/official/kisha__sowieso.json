  "title": "Sowieso",
  "original_header": "SWISS GERMAN",
  "simlish_header": "SIMLISH",
  "pairs": [
    {
      "line_index": 0,
      "original": "So geil wie du isch nid mau dr Kuno",
      "simlish": "To bi za du misch ni blau ni kuzu"
    },
    {
      "line_index": 1,
      "original": "Bisch immer vou derbi",
      "simlish": "Bazh imma fwe dobli"
    },
    {
      "line_index": 2,
      "original": "Hesch die gröschti, nöschti Hifi-alag",
      "simlish": "Hezh a brozhi, brozhi Hafi-anag"
    },
    {
      "line_index": 3,
      "original": "Zahlt het se dänk z mammi",
      "simlish": "Teb haki hekbt bavi"
    },
    {
      "line_index": 4,
      "original": "Ä so ne schliimer wie du eine bisch",
      "simlish": "A slo ble slimer a dov vi blezh"
    },
    {
      "line_index": 5,
      "original": "Isch ging parat, ja klar",
      "simlish": "Et sing parat, jo va"
    },
    {
      "line_index": 6,
      "original": "Ä chlini frag, die stellt sich haut",
      "simlish": "A blini fla, ti del ba va"
    },
    {
      "line_index": 7,
      "original": "Hesch z Gfühl du sigsch dr star?",
      "simlish": "Atsiel gitish gashta"
    },
    {
      "line_index": 8,
      "original": "Ja sowieso",
      "simlish": "Wa zoley sto"
    },
    {
      "line_index": 9,
      "original": "Hesch du ja o immer rëcht",
      "simlish": "Misch tu ba ya imga ruks"
    },
    {
      "line_index": 10,
      "original": "Und sowieso",
      "simlish": "Un zoley sto"
    },
    {
      "line_index": 11,
      "original": "Isch aues was glänzt ou ächt",
      "simlish": "Mitsaba tsban vi tsoks"
    }
  ]
